{
  "compilerOptions": {
    "target": "ES2017",

    "module": "Node16",

    "rootDir": "./src",

    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,

    "resolveJsonModule": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "moduleResolution": "node16",

    "types": ["node", "jest"]
  },

  "include": ["src"],

  "exclude": [
    "node_modules",
    "dist",
    "jest.config.ts"
  ]
}